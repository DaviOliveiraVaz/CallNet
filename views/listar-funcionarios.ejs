<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="funcionarios.css">
    <title>Listagem de Funcionários</title>
</head>
<body>
    <header>
        <div class="top-header">
            <div class="menu-icon" onclick="toggleMenu()">&#9776;</div>
            <a href="/sair" class="logout"><img src="sair-icon.png" alt="" width="28px" onclick="return confirm('Tem certeza que deseja sair?')"></a>
        </div>
        <nav class="sidebar" id="sidebar">
            <ul>
                <li><img src="chamados-icon.png" alt="Ícone de Chamados" width="30px"><a href="/listar-chamados"><span class="menu-text">CHAMADOS</span></a></li>
                <li><img src="criar_chamado-icon.png" alt="Ícone de Criar Chamado" width="30px"><a href="/chamados"><span class="menu-text">CRIAR CHAMADO</span></a></li>
                <li><img src="cadastrar-icon.png" alt="Ícone de Cadastrar Cliente" width="30px"><a href="/clientes"><span class="menu-text">CADASTRAR CLIENTE</span></a></li>
                <li><img src="cadastrar-icon.png" alt="Ícone de Cadastrar Funcionário" width="30px"><a href="/cadastro"><span class="menu-text">CADASTRAR FUNCIONARIO</span></a></li>
                <li><img src="cadastrados-icon.png" alt="Ícone de Clientes" width="30px"><a href="/listar-clientes"><span class="menu-text">CLIENTES</span></a></li>
                <li><img src="cadastrados-icon.png" alt="Ícone de Funcionários" width="30px"><a href="/listar-funcionarios"><span class="menu-text">FUNCIONARIOS</span></a></li>
            </ul>
        </nav>
    </header>

    <div id="modal" class="modal">
        <div class="modal-content">
            <span class="close-button" onclick="closeModal()">&times;</span>
            <h2>Dados do Funcionário</h2>
            <p id="employee-data"></p>
        </div>
    </div>

    <div class="content">
        <h1>FUNCIONÁRIOS</h1>
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>Email</th>
                    <th>Endereço</th>
                    <th>Telefone</th>
                    <th>Opções</th>
                </tr>
            </thead>
            <tbody>
                <% Usuarios.forEach(function(usuario) { %>
                <tr>
                    <td><%= usuario.nome %></td>
                    <td><%= usuario.cpf %></td>
                    <td><%= usuario.email %></td>
                    <td><%= usuario.endereco %></td>
                    <td><%= usuario.telefone %></td>
                    <td>
                        <a href="/editar-funcionario/<%= usuario._id %>" class="btn-edit">
                            <img src="editar-icon.png" alt="Editar" width="30px">
                        </a>
                        <% if (usuarioLogado.permissao === "1") { %>
                            <a href="/deletar-funcionario/<%= usuario._id %>" onclick="return confirm('Tem certeza que deseja excluir o funcionário?')" class="btn-delete">
                                <img src="deletar-icon.png" alt="Deletar" width="30px">
                            </a>
                        <% } else if (usuarioLogado.permissao === "2") { %>
                            <a href="#" onclick="openModal({
                                nome: '<%= usuario.nome %>',
                                cpf: '<%= usuario.cpf %>',
                                email: '<%= usuario.email %>',
                                endereco: '<%= usuario.endereco %>',
                                telefone: '<%= usuario.telefone %>'
                            }); return false;" class="btn-delete">
                                <img src="view-icon.png" alt="Visualizar" width="30px">
                            </a>
                        <% } %>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <script>
        function toggleMenu() {
            const sidebar = document.getElementById('sidebar');
            const content = document.querySelector('.content');
            sidebar.classList.toggle('active');
            content.classList.toggle('active');
        }

        function openModal(employee) {
        document.getElementById('employee-data').innerText = `
            Nome: ${employee.nome}
            CPF: ${employee.cpf}
            Email: ${employee.email}
            Endereço: ${employee.endereco}
            Telefone: ${employee.telefone}
        `;
        document.getElementById('modal').style.display = 'block';
    }

    function closeModal() {
        document.getElementById('modal').style.display = 'none';
    }
    </script>
</body>
</html>