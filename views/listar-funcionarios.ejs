<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="funcionarios.css">
    <title>Listagem de Funcionários</title>
</head>

<body>
    <header>
        <ul>
            <li><a href="/listar-chamados">CHAMADOS</a></li>
            <li><a href="/chamados">CRIAR CHAMADO</a></li>
            <li><a href="/clientes">CADASTRAR CLIENTE</a></li>
            <li><a href="/cadastro">CADASTRAR FUNCIONARIO</a></li>
            <li><a href="/listar-clientes">CLIENTES</a></li>
            <li><a href="/listar-funcionarios">FUNCIONARIOS</a></li>
          </ul>
        </header>
    <h1>FUNCIONÁRIOS</h1>
    <table>
        <tr>
            <th>Nome</th>
            <th>CPF</th>
            <th>Email</th>
            <th>Endereço</th>
            <th>Telefone</th>
            <th>Opções</th>
        </tr>
        <%Usuarios.forEach(function(usuario){%>
        <tr>
            <td><%=usuario.nome%></td>
            <td><%=usuario.cpf%></td>
            <td><%=usuario.email%></td>
            <td><%=usuario.endereco%></td>
            <td><%=usuario.telefone%></td>
            <td><a href="/editar-funcionario/<%=usuario._id%>">Editar</a></td>
            <td><a href="/deletar-funcionario/<%=usuario._id%>" onclick="return confirm('Tem certeza que deseja excluir o funcionário?')">Excluir</a></td>
        </tr>
        <%})%>
    </table>
</body>

</html>