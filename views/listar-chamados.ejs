<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="chamados.css">
    <title>Listagem de Chamados</title>
</head>

<body>
    <header>
        <div class="top-header">
            <div class="menu-icon" onclick="toggleMenu()">&#9776;</div>
            <a href="/sair" class="logout"><img src="sair-icon.png" alt="" width="28px" onclick="return confirm('Tem certeza que deseja sair?')"></a>
        </div>
        <nav class="sidebar" id="sidebar">
            <ul>
                <li><img src="chamados-icon.png" alt="Ícone de Chamados" width="30px"><a href="/listar-chamados"><span class="menu-text">CHAMADOS</span></a></li>
                <li><img src="criar_chamado-icon.png" alt="Ícone de Criar Chamado" width="30px"><a href="/chamados"><span class="menu-text">CRIAR CHAMADO</span></a></li>
                <li><img src="cadastrar-icon.png" alt="Ícone de Cadastrar Cliente" width="30px"><a href="/clientes"><span class="menu-text">CADASTRAR CLIENTE</span></a></li>
                <li><img src="cadastrar-icon.png" alt="Ícone de Cadastrar Funcionário" width="30px"><a href="/cadastro"><span class="menu-text">CADASTRAR FUNCIONARIO</span></a></li>
                <li><img src="cadastrados-icon.png" alt="Ícone de Clientes" width="30px"><a href="/listar-clientes"><span class="menu-text">CLIENTES</span></a></li>
                <li><img src="cadastrados-icon.png" alt="Ícone de Funcionários" width="30px"><a href="/listar-funcionarios"><span class="menu-text">FUNCIONARIOS</span></a></li>
            </ul>
        </nav>
    </header>
    <div class="content">
    <h1>CHAMADOS NO SISTEMA</h1>
    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Titulo</th>
            <th>Prioridade</th>
            <th>Tipo</th>
            <th>Nome</th>
            <th>Status</th>
            <th>Data</th>
            <th>Observação</th>
            <th>Opções</th>
        </tr>
        </thead>
        <tbody>
        <%Chamados.forEach(function(chamado){%>
        <tr>
            <td><%=chamado.id%></td>
            <td><%=chamado.titulo%></td>
            <td><%=chamado.prioridade%></td>
            <td><%=chamado.tipo%></td>
            <td><%=chamado.nome%></td>
            <td><%=chamado.status%></td>
            <td><%=chamado.data%></td>
            <td><%=chamado.observacao%></td>
            <td>
                <a href="#" onclick="editarObservacao('<%=chamado._id%>', '<%=chamado.observacao%>')" class="btn-edit"><img src="editar-icon.png" alt="" width="30px"></a>
                <a href="/deletar/<%=chamado._id%>" onclick="return confirm('Tem certeza que deseja excluir o chamado?')" class="btn-delete"><img src="deletar-icon.png" alt="" width="30px"></a>
            </td>
        </tr>
        <%})%>
    </tbody>
    </table>
</div>
    <script>
        function editarObservacao(chamadoId, observacaoAtual) {
            const novaObservacao = prompt("Editar Observação", observacaoAtual);
            if (novaObservacao !== null) {
                fetch(`/editarChamadoObservacao/${chamadoId}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ observacao: novaObservacao }),
                })
                .then((response) => {
                    if (response.ok) {
                        alert("Observação atualizada com sucesso!");
                        location.reload();
                    } else {
                        alert("Erro ao atualizar a observação.");
                    }
                })
                .catch((error) => {
                    console.error("Erro ao atualizar:", error);
                    alert("Erro ao atualizar a observação.");
                });
            }
        }

        function toggleMenu() {
            const sidebar = document.getElementById('sidebar');
            const content = document.querySelector('.content');
            sidebar.classList.toggle('active');
            content.classList.toggle('active');
        }
    </script>
</body>

</html>