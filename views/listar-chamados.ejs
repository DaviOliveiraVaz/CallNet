<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="chamados.css">
    <title>Listagem de Chamados</title>
</head>

<body>
    <header>
    <ul>
        <li><a href="/listar-chamados">CHAMADOS</a></li>
        <li><a href="/chamados">CRIAR CHAMADO</a></li>
        <li><a href="/clientes">CADASTRAR CLIENTE</a></li>
        <li><a href="/cadastro">CADASTRAR FUNCIONARIO</a></li>
        <li><a href="/listar-clientes">CLIENTES</a></li>
        <li><a href="/listar-funcionarios">FUNCIONARIOS</a></li>
      </ul>
    </header>
    <h1>CHAMADOS NO SISTEMA</h1>
    <table>
        <tr>
            <th>ID</th>
            <th>Titulo</th>
            <th>Prioridade</th>
            <th>Tipo</th>
            <th>Nome</th>
            <th>Status</th>
            <th>Data</th>
            <th>Observação</th>
            <th>Opções</th>
        </tr>
        <%Chamados.forEach(function(chamado){%>
        <tr>
            <td><%=chamado.id%></td>
            <td><%=chamado.titulo%></td>
            <td><%=chamado.prioridade%></td>
            <td><%=chamado.tipo%></td>
            <td><%=chamado.nome%></td>
            <td><%=chamado.status%></td>
            <td><%=chamado.data%></td>
            <td><%=chamado.observacao%></td>
            <td>
                <a href="#" onclick="editarObservacao('<%=chamado._id%>', '<%=chamado.observacao%>')">Editar</a>
            </td>
            <td><a href="/deletar/<%=chamado._id%>" onclick="return confirm('Tem certeza que deseja excluir o chamado?')">Excluir</a></td>
        </tr>
        <%})%>
    </table>

    <script>
        function editarObservacao(chamadoId, observacaoAtual) {
            const novaObservacao = prompt("Editar Observação", observacaoAtual);
            if (novaObservacao !== null) {
                fetch(`/editarChamadoObservacao/${chamadoId}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ observacao: novaObservacao }),
                })
                .then((response) => {
                    if (response.ok) {
                        alert("Observação atualizada com sucesso!");
                        location.reload();
                    } else {
                        alert("Erro ao atualizar a observação.");
                    }
                })
                .catch((error) => {
                    console.error("Erro ao atualizar:", error);
                    alert("Erro ao atualizar a observação.");
                });
            }
        }
    </script>
</body>

</html>